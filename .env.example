# Copy this file to .env and adjust values for your machine.
# Existing system environment variables take precedence over .env values.

# Project paths
# PTM_BASE_DIR=C:\Users\123\Desktop\Soybean
# PTM_BLAST_DB_GLYCINE_MAX=C:\Users\123\Desktop\Soybean\data\blastdb\soybean
# PTM_BLAST_DB_BRADYRHIZOBIUM_DIAZOEFFICIENS=C:\Users\123\Desktop\Soybean\data\blastdb\rhizobium

# PostgreSQL and application database settings
PTM_DB_SERVICE=postgres
PTM_DB_HOST=127.0.0.1
PTM_DB_PORT=5432
PTM_PG_DATA_DIR=./runtime/pg_data
# initdb scripts create ptm_prod. Keep this value unless those scripts change.
PTM_DB_NAME=ptm_prod
PTM_DB_USER=myuser
PTM_DB_PASSWORD=wowangle
PTM_DB_CONNECT_TIMEOUT=5
PTM_DB_POOL_MIN_SIZE=1
PTM_DB_POOL_MAX_SIZE=8

# Docker PostgreSQL bootstrap database. Keep this as postgres unless you also
# update initdb scripts; the application database is PTM_DB_NAME.
POSTGRES_DB=postgres

# Search and table defaults
PTM_SEARCH_MAX_RESULTS=500
PTM_SEARCH_PAGE_SIZE_DEFAULT=50
DATA_TABLE_PAGE_SIZE_DEFAULT=50

# Download and raw data preview controls
PTM_DOWNLOADS_ENABLED=false

# User authentication and tester permissions
PTM_AUTH_ENABLED=true
PTM_AUTH_SECRET_KEY=replace-with-a-long-random-secret
PTM_AUTH_SESSION_DAYS=7
PTM_AUTH_COOKIE_SECURE=false
PTM_AUTH_MAX_FAILED_ATTEMPTS=5
PTM_AUTH_LOCKOUT_MINUTES=30
PTM_AUTH_IP_MAX_FAILED_ATTEMPTS=20
PTM_AUTH_IP_WINDOW_MINUTES=15
PTM_AUTH_PASSWORD_MIN_LENGTH=10
PTM_AUTH_PASSWORD_MAX_LENGTH=256
PTM_AUTH_PBKDF2_ITERATIONS=600000
PTM_BOOTSTRAP_ADMIN_USERNAME=admin
PTM_BOOTSTRAP_ADMIN_PASSWORD=

# BLAST defaults
PTM_BLAST_MAX_DB_SEQUENCES=200000
PTM_BLAST_DEFAULT_IDENTITY_MIN=30
PTM_BLAST_DEFAULT_E_VALUE_MAX=1e-5
PTM_BLAST_DEFAULT_QUERY_COVER_MIN=70
PTM_BLAST_DEFAULT_MAX_HITS=20

# UniProt settings
PTM_UNIPROT_TIMEOUT_SEC=10
PTM_UNIPROT_SSL_VERIFY=true
PTM_UNIPROT_CA_FILE=

# Soybean Assistant / Hermes
HERMES_ASSISTANT_ENABLED=false
HERMES_TOOL_RECORD_LIMIT_DEFAULT=10
HERMES_TOOL_RECORD_LIMIT_MAX=50
HERMES_BLAST_SEQUENCE_MAX=5000
HERMES_OLLAMA_ENABLED=true
HERMES_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
HERMES_OLLAMA_MODEL=qwen3:8b
HERMES_OLLAMA_TIMEOUT=30
HERMES_OLLAMA_ROUTER_TIMEOUT=8
HERMES_OLLAMA_SUMMARY_TIMEOUT=12
HERMES_CHAT_PROVIDER=ollama
HERMES_CHAT_ENABLED=true
HERMES_CHAT_BASE_URL=http://127.0.0.1:11434/v1
HERMES_CHAT_MODEL=qwen3:8b
HERMES_CHAT_API_KEY=
# Relative paths are resolved from soybean_app/.
HERMES_AGENT_DIR=hermes_agent
