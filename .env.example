PTM_DB_SERVICE=postgres
PTM_DB_HOST=127.0.0.1
PTM_DB_PORT=5432
PTM_DB_NAME=ptm_prod
PTM_DB_USER=myuser
PTM_DB_PASSWORD=replace-with-a-local-password
PTM_DB_CONNECT_TIMEOUT=5
PTM_DB_POOL_MIN_SIZE=1
PTM_DB_POOL_MAX_SIZE=8

PTM_SEARCH_MAX_RESULTS=500
PTM_SEARCH_PAGE_SIZE_DEFAULT=50
PTM_BLAST_MAX_DB_SEQUENCES=200000
PTM_BLAST_DEFAULT_IDENTITY_MIN=30
PTM_BLAST_DEFAULT_E_VALUE_MAX=1e-5
PTM_BLAST_DEFAULT_QUERY_COVER_MIN=70
PTM_BLAST_DEFAULT_MAX_HITS=20
